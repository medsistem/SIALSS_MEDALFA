<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="factura" language="groovy" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1d36d56d-e705-43d8-bec6-461dd4e714a4">
	<property name="ireport.zoom" value="2.253944402704733"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Folfact" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Mov" class="java.lang.String"/>
	<parameter name="proyecto" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	M.F_DocMov AS F_ClaDoc,
	CONCAT( "Fecha [ ", DATE_FORMAT( M.F_FecMov, '%d/%m/%Y' ), " ]" ) AS F_FecEnt,
	CONCAT( "[ ", M.F_ConMov, " ] ", U.F_DesCon ) AS F_NomCli,
	M.F_ProMov AS F_ClaPro,
	MD.F_DesPro,
	FORMAT( M.F_CantMov, 0 ) AS F_CantSur,
	FORMAT( M.F_CostMov, 2 ) AS F_Costo,
	FORMAT( M.F_TotMov, 2 ) AS F_Monto,
	L.F_ClaLot,
	DATE_FORMAT( L.F_FecCad, '%d/%m/%Y' ) AS F_FecCad,
	O.F_Obser ,
	date_format( L.F_FecFab, '%d/%m/%Y' ) AS F_FecFab,
	mr.F_DesMar
FROM
	tb_movinv M
	INNER JOIN tb_coninv U ON M.F_ConMov = U.F_IdCon
	INNER JOIN tb_medica MD ON M.F_ProMov = MD.F_ClaPro
	INNER JOIN tb_lote L ON M.F_LotMov = L.F_FolLot
	AND M.F_UbiMov = L.F_Ubica
	AND M.F_ProMov = L.F_ClaPro
	LEFT JOIN tb_obsmov O ON M.F_DocMov = O.F_IdFact
	INNER JOIN tb_marca mr ON L.F_ClaMar = mr.F_ClaMar
WHERE
	F_DocMov = $P{Folfact}
	AND F_ConMov = $P{Mov}
	AND F_Proyecto = $P{proyecto}
GROUP BY
	O.F_IdFact,
	m.F_ProMov,
	L.F_ClaLot;]]>
	</queryString>
