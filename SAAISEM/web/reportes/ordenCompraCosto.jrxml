<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ordenCompra" language="groovy" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f59271d3-8d37-4164-b6ae-641800414185">
	<property name="ireport.zoom" value="1.8181818181818197"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="1"/>
	<style name="table">
		<box>
			<pen lineWidth="1.0" lineColor="#000000"/>
		</box>
	</style>
	<parameter name="ordenCompra" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	w.F_DesProy,
	o.F_NoCompra,
	p.F_NomPro,
  DATE_FORMAT(o.F_FecSur, '%d/%m/%Y'),
	o.F_HorSur,
	CASE WHEN uc.F_TipUsu = '13' THEN CONCAT(uc.F_Usu,'-','Compra') ELSE u.F_Usu END as F_Usu,
	F_StsPed,
	o.F_FecSur,
	o.F_Clave,
	o.F_Obser,
	m.F_DesPro,
	o.F_Cant,
	( @csum := @csum + o.F_Cant ) AS totales,
	o.F_Iva,
	o.F_Precio,
	o.F_Descuento,
	( o.F_Precio * ( o.F_Descuento / 100 ) ) AS descuentoProd,
		( o.F_Cant * o.F_Precio ) AS importe,
		( @ssum := @ssum + ( o.F_Cant * o.F_Precio ) ) AS subtotal,
	( @dsum := @dsum + o.F_Cant * ( o.F_Precio * ( o.F_Descuento / 100 ) ) ) AS descuento,
		( @tsum := ( @ssum - @dsum ) + @isum ) AS total,
	(@isum := (( o.F_Cant * ( o.F_Precio - ( o.F_Precio * ( o.F_Descuento / 100 ) ) ) ) * ( o.F_Iva / 100 ) ) ) AS iva,

	p.F_Dir,
	p.F_Rfc,
	p.F_Tel,
	p.F_Mail,
	p2.F_NomPro as F_NomPro2,
	p2.F_Dir as F_Dir2,
	p2.F_Rfc as F_Rfc2,
	p2.F_Tel as F_Tel2,
	p2.F_Mail as F_Mail2,
	tm.F_Moneda as F_Tipo,
	cdi.CFDI as F_cdi,
o.Plazo_pago as F_pago,
DATE_FORMAT(o.Fecha_Vencimiento, '%d/%m/%Y')  as Fec_ven,
w.F_Encabezado
FROM
	( SELECT @csum := 0 ) r,
	( SELECT @ssum := 0 ) s,
	( SELECT @dsum := 0 ) d,
	( SELECT @tsum := 0 ) t,
	( SELECT @isum := 0 ) i,
	tb_pedido_sialss o
	INNER JOIN tb_proveedor p ON o.F_Provee = p.F_ClaProve
	INNER JOIN tb_prove_entrega p2 ON o.F_UniMed = p2.F_ClaProve
	INNER JOIN tb_medica m ON o.F_Clave = m.F_ClaPro
	INNER JOIN tb_proyectos w ON o.F_Proyecto = w.F_Id
	LEFT JOIN tb_usuariocompra uc ON uc.F_IdUsu = o.F_IdUsu
	LEFT JOIN tb_usuario u ON u.F_IdUsu = o.F_IdUsu
	INNER JOIN tb_tipo_moneda tm ON o.F_Tipo = tm.Id_Moneda
	INNER JOIN tb_cfdi cdi ON o.F_CDI = cdi.id_CFDI
WHERE
	F_NoCompra = $P{ordenCompra} order by totales]]>
	</queryString>
