<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<%
    String warName = request.getContextPath();
    String Nombrewar = warName.replace("/", "");
    // Tablas anchas con scroll horizontal en todas las pantallas (también las que no tienen menú).
    // No en exportaciones (Excel, texto): ensuciaría el archivo.
    String piePaginaTipo = response.getContentType() == null ? "" : response.getContentType().toLowerCase();
    boolean piePaginaHtml = piePaginaTipo.isEmpty() || piePaginaTipo.startsWith("text/html");
%>
<% if (piePaginaHtml) { %>
<link href="<%=warName%>/css/sialss-app.css?v=2.0.16" rel="stylesheet">
<script src="<%=warName%>/js/sialss-tablas.js?v=3" defer></script>
<% } %>
<br><br><br>
<br><br><br>
<div class="navbar navbar-inverse navbar-fixed-bottom">
    <div class="text-center" style="color: white; bottom: auto">
        <%=Nombrewar%> | Desarrollo de Aplicaciones
        <div id="current_date">
            <script>
                date = new Date();
                year = date.getFullYear();
                month = date.getMonth() + 1;
                day = date.getDate();
                document.getElementById("current_date").innerHTML = '2019 -' + year;
            </script>
            <span class="glyphicon glyphicon-registration-mark"></span><br />
            Todos los Derechos Reservados
        </div>
    </div>
</div>