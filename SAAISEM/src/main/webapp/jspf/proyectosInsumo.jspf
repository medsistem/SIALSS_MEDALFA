<%-- Casillas "Proyectos del insumo" para AltaClave.jsp y ModiClave.jsp. Salen de tb_proyectos (F_Campo), así un proyecto
     nuevo aparece solo. En tres columnas y en orden alfabético (sin distinguir acentos ni mayúsculas).
     La página define antes: java.util.Set<String> proyectosMarcados (columnas marcadas; vacío = ninguna).
     Envía proyecto=<columna> por cada casilla y proyectosEnviados=1 (para que el servlet sepa que debe actualizarlos). --%>
<%@ page pageEncoding="UTF-8" %>
<%
    java.util.List<mx.medalfa.sialss.proyectos.CamposProyecto.Campo> camposProyectoInsumo = new java.util.ArrayList<>();
    try (java.sql.Connection cxProyectos = mx.medalfa.sialss.config.BaseDatos.GENERAL.conexion()) {
        camposProyectoInsumo.addAll(mx.medalfa.sialss.proyectos.CamposProyecto.listar(cxProyectos));
    } catch (Exception exProyectos) {
        java.util.logging.Logger.getLogger("proyectosInsumo.jspf").log(java.util.logging.Level.SEVERE, null, exProyectos);
    }
    java.text.Collator ordenProyectos = java.text.Collator.getInstance(java.util.Locale.forLanguageTag("es-MX"));
    ordenProyectos.setStrength(java.text.Collator.PRIMARY);
    camposProyectoInsumo.sort((a, b) -> ordenProyectos.compare(
            String.valueOf(a.proyecto()).replace('_', ' ').trim(), String.valueOf(b.proyecto()).replace('_', ' ').trim()));
%>
<fieldset class="sialss-proyectos-insumo">
    <legend>Proyectos del insumo</legend>
    <input type="hidden" name="proyectosEnviados" value="1">
    <div class="sialss-proyectos-insumo__lista">
        <% for (mx.medalfa.sialss.proyectos.CamposProyecto.Campo cpi : camposProyectoInsumo) {
               String idCasilla = "proyecto_" + cpi.columna();
               String nombreProyecto = cpi.proyecto() == null ? "" : cpi.proyecto().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"); %>
        <label for="<%=idCasilla%>">
            <input type="checkbox" name="proyecto" id="<%=idCasilla%>" value="<%=cpi.columna()%>"<%= proyectosMarcados.contains(cpi.columna()) ? " checked" : "" %>>
            <span><%=nombreProyecto%> <small>(<%=cpi.idProyecto()%>)</small></span>
        </label>
        <% } %>
    </div>
    <% if (camposProyectoInsumo.isEmpty()) { %>
    <p class="text-danger">No se pudieron leer los proyectos.</p>
    <% } %>
</fieldset>
