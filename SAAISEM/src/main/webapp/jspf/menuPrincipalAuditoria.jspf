<%-- Menú de Auditoría. Las opciones de cada perfil están en menu-roles.csv (skill menu-roles-sialss); el orden es el mismo para todos. --%>
<%@ page pageEncoding="UTF-8" %>
<%@include file="sialssBarra.jspf" %>
<% mx.medalfa.sialss.seguridad.Acceso menuAcceso = mx.medalfa.sialss.seguridad.Acceso.AUDITORIA; %>
<%@include file="menuSialss.jspf" %>
<% if ("27".equals(tipo)) { %>
<%-- Perfil 27: aviso para importar información (se conserva del menú anterior; no tiene opciones de menú). --%>
<div class="modal fade" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Aviso</h4>
            </div>
            <div class="modal-body">
                <h4>¿Importar información?</h4>
            </div>
            <div class="modal-footer">
                <a href="<%=sialssCtx%>/cargarInformacion.jsp" class="btn btn-success">Aceptar</a>
                <a href="<%=sialssCtx%>/indexAuditoria.jsp" class="btn btn-danger">Cerrar</a>
            </div>
        </div>
    </div>
</div>
<% } %>
