<%-- Menú por perfil común a todos los accesos. Lo incluyen jspf/menuPrincipal*.jspf después de definir
       mx.medalfa.sialss.seguridad.Acceso menuAcceso
     y requiere la variable "tipo" (perfil F_TipUsu) que ya define cada página.
     Qué ve cada perfil: src/main/resources/mx/medalfa/sialss/menu/menu-roles.csv (skill menu-roles-sialss). --%>
<%@ page pageEncoding="UTF-8" %>
<div class="navbar navbar-default sialss-menu" id="sialss-menu">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="<%=sialssCtx%>/<%=menuAcceso.menu%>"><span class="glyphicon glyphicon-home"></span></a>
        </div>
        <div class="navbar-collapse collapse">
            <ul class="nav navbar-nav">
<%=mx.medalfa.sialss.menu.MenuSialss.html(menuAcceso, tipo, sialssCtx)%>
            </ul>
            <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> <%=sialssUsuario.isEmpty() ? sialssNombre : sialssUsuario%></a></li>
                <li class="active"><a href="<%=sialssCtx%>/<%=menuAcceso.paginaLogin%>" title="Cerrar sesión"><span class="glyphicon glyphicon-log-out"></span><span class="sr-only">Cerrar sesión</span></a></li>
            </ul>
        </div>
    </div>
</div>
