<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 2.7 es la última línea que corre sobre javax (Java EE) en
        vez de jakarta. 2.7.18 es su último parche. Soporte público ya
        terminado: funciona bien, pero no recibe correcciones de seguridad
        gratuitas. Fue la opción elegida para quedar en el mismo mundo javax
        que el SIALSS actual.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>mx.medicalminds</groupId>
    <artifactId>almacen-med</artifactId>
    <version>1.0.0</version>
    <name>almacen-med</name>
    <description>Almacén de medicamentos e insumos médicos</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            JoinFaces 4.7.x es la línea que empata con Spring Boot 2.7 y
            JSF 2.3 sobre javax. Requiere Java 8 a 17.
        -->
        <joinfaces.version>4.7.18</joinfaces.version>

        <!-- 2.7.x es la rama del driver compatible con Java 8; la 3.x pide Java 11 -->
        <mariadb.version>2.7.12</mariadb.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Esta BOM fija la versión de JSF, PrimeFaces y compañía, por eso
                abajo esas dependencias van sin <version>.
            -->
            <dependency>
                <groupId>org.joinfaces</groupId>
                <artifactId>joinfaces-dependencies</artifactId>
                <version>${joinfaces.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- JSF (Mojarra) + Tomcat embebido, configurados por JoinFaces -->
        <dependency>
            <groupId>org.joinfaces</groupId>
            <artifactId>jsf-spring-boot-starter</artifactId>
        </dependency>

        <!-- PrimeFaces: menú, tablas, diálogos -->
        <dependency>
            <groupId>org.joinfaces</groupId>
            <artifactId>primefaces-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>almacen-med</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
