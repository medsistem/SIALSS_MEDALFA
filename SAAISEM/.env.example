# SIALSS_MDF_1 - configuración. Copie como sialss.env y llene las contraseñas.
# Ubicación en el servidor: C:\Despliegue\SIALSS_MDF_1\sialss.env (o la ruta en la variable SIALSS_ENV).
# Si el context.xml declara un recurso jdbc/..., ese recurso gana sobre estos datos.

BD_URL=jdbc:mariadb://127.0.0.1:3306/sialss_mdf?useUnicode=true&characterEncoding=UTF-8
BD_POOL_MAXIMO=30

# Usuario general (ConectionDB, ConectionDBTrans, conection)
BD_USUARIO=sialss_mdf
BD_CONTRASENA=

# Usuarios por área (ConnectionManager / Source)
BD_RECEPCION_USUARIO=recepcion_sialss_mdf
BD_RECEPCION_CONTRASENA=
BD_AUDITORIA_USUARIO=auditoria_sialss_mdf
BD_AUDITORIA_CONTRASENA=
BD_ALMACEN_USUARIO=almacen_sialss_mdf
BD_ALMACEN_CONTRASENA=
BD_FACTURACION_USUARIO=facturacion_sialss_mdf
BD_FACTURACION_CONTRASENA=

# Seguridad de sesión (minutos). Bloqueo de pantalla pide la contraseña; cierre manda al inicio de sesión.
LOGIN_INTENTOS=3
SESION_BLOQUEO_MIN=5
SESION_CIERRE_MIN=60

# Modula (SQL Server). Vacío = deshabilitado, como estaba.
SQLSERVER_URL=
SQLSERVER_USUARIO=
SQLSERVER_CONTRASENA=

# PIN de inicio de sesión: número de dígitos (4 a 8)
PIN_DIGITOS=6
